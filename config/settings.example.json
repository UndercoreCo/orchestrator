{
  "schema_version": 1,
  "experimental_trusttunnel": false,
  "state_directory": "/var/lib/vpn-orchestrator",
  "backend_token_file": "/etc/vpn-orchestrator/backend.token",
  "nodes": [
    {
      "id": "node-a",
      "api_url": "https://node-api.example.invalid",
      "server_id": "node-a-identity",
      "region": "nl",
      "capacity": 100,
      "mode": "disabled",
      "protocol": "amneziawg",
      "api_key_file": "/etc/vpn-orchestrator/node-a.token"
    }
  ],
  "policy": {
    "agents": {
      "operation_timeout_seconds": 30,
      "queue_timeout_seconds": 2,
      "max_concurrent_requests": 16,
      "max_concurrent_per_node": 4,
      "max_pending_requests": 64,
      "max_pending_per_node": 8,
      "connect_timeout_seconds": 4,
      "response_timeout_seconds": 12
    }
  }
}
