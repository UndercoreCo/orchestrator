  "Health": {
    "$defs": {
      "Guarantees": {
        "additionalProperties": false,
        "properties": {
          "idempotent_create": {
            "title": "Idempotent Create",
            "type": "boolean"
          },
          "enforces_expiry": {
            "title": "Enforces Expiry",
            "type": "boolean"
          },
          "confirmed_revoke": {
            "title": "Confirmed Revoke",
            "type": "boolean"
          }
        },
        "required": [
          "idempotent_create",
          "enforces_expiry",
          "confirmed_revoke"
        ],
        "title": "Guarantees",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": 1,
        "title": "Schema Version",
        "type": "integer"
      },
      "server_id": {
        "pattern": "^[A-Za-z0-9_-]{1,100}$",
        "title": "Server Id",
        "type": "string"
      },
      "protocol": {
        "const": "trusttunnel",
        "title": "Protocol",
        "type": "string"
      },
      "status": {
        "const": "ok",
        "title": "Status",
        "type": "string"
      },
      "capabilities": {
        "$ref": "#/$defs/Guarantees"
      }
    },
    "required": [
      "schema_version",
      "server_id",
      "protocol",
      "status",
      "capabilities"
    ],
    "title": "Health",
    "type": "object"
  },
  "Create": {
    "additionalProperties": false,
